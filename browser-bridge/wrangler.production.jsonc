{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "oh-tools-signaling",
  "main": "cloudflare-worker.js",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{"pattern":"signaling.oh-tools.net","custom_domain":true}],
  "durable_objects": {"bindings": [{"name":"SIGNALING_INBOXES","class_name":"SignalingInbox"}]},
  "migrations": [{"tag":"inboxes-v1","new_sqlite_classes":["SignalingInbox"]}],
  "ratelimits": [{"name":"RATE_LIMITER","namespace_id":"1001","simple":{"limit":10,"period":60}}]
}
