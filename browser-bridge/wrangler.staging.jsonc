{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "oh-tools-signaling-staging",
  "main": "cloudflare-worker.js",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "durable_objects": {"bindings": [{"name":"SIGNALING_INBOXES","class_name":"SignalingInbox"}]},
  "migrations": [{"tag":"inboxes-v1","new_sqlite_classes":["SignalingInbox"]}],
  "ratelimits": [{"name":"RATE_LIMITER","namespace_id":"1002","simple":{"limit":10,"period":60}}]
}
