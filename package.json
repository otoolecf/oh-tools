{
  "name": "otoolebox",
  "version": "1.0.0",
  "description": "Browser-based utilities with local file processing and optional WebRTC signaling.",
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && vite --host 127.0.0.1",
    "build": "node scripts/prepare-assets.mjs && vite build && node scripts/check-build.mjs",
    "build:staging": "node scripts/prepare-assets.mjs --staging && vite build --mode staging && node scripts/check-build.mjs --staging",
    "preview": "wrangler dev --port 4173",
    "deploy": "npm run build && wrangler deploy",
    "deploy:staging": "npm run build:staging && wrangler deploy --env staging",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "dev:signaling": "node browser-bridge/mock-server.js",
    "deploy:signaling": "wrangler deploy --config browser-bridge/wrangler.toml",
    "test": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otoolecf/otoolebox.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/otoolecf/otoolebox/issues"
  },
  "homepage": "https://github.com/otoolecf/otoolebox#readme",
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.29.1-dev266.0",
    "@noble/hashes": "2.4.0",
    "bwip-js": "4.7.0",
    "diff": "8.0.4",
    "exifreader": "4.52.0",
    "heic-to": "1.6.7",
    "json5": "2.2.3",
    "jsonrepair": "3.13.0",
    "mediabunny": "1.32.0",
    "passhelp": "1.1.1",
    "wasm-vips": "0.0.14"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "vite": "8.3.5",
    "wrangler": "4.156.0"
  }
}
