# Default headers for all pages
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Special headers for image-editor to enable SharedArrayBuffer/WASM
/image-editor/*
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: cross-origin

# Allow WASM files globally
/*.wasm
  Content-Type: application/wasm
  Cross-Origin-Resource-Policy: cross-origin

# Allow nested WASM files
/*/*.wasm
  Content-Type: application/wasm
  Cross-Origin-Resource-Policy: cross-origin

# Allow JS modules globally
/*.js
  Cross-Origin-Resource-Policy: cross-origin

# Allow nested JS files
/*/*.js
  Cross-Origin-Resource-Policy: cross-origin

# Force correct MIME types for specific node_modules JS files
/image-editor/node_modules/wasm-vips/lib/vips.js
  Content-Type: application/javascript
  Cross-Origin-Resource-Policy: cross-origin

/image-editor/node_modules/heic-to/dist/iife/heic-to.js
  Content-Type: application/javascript  
  Cross-Origin-Resource-Policy: cross-origin

/image-editor/node_modules/exifreader/dist/exif-reader.js
  Content-Type: application/javascript
  Cross-Origin-Resource-Policy: cross-origin