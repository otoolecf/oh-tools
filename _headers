# Default headers for all pages
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Special headers for image-editor to enable SharedArrayBuffer/WASM
/image-editor/*
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: cross-origin

# Allow WASM files globally
/*.wasm
  Content-Type: application/wasm
  Cross-Origin-Resource-Policy: cross-origin

# Allow nested WASM files
/*/*.wasm
  Content-Type: application/wasm
  Cross-Origin-Resource-Policy: cross-origin

# Allow JS modules globally
/*.js
  Cross-Origin-Resource-Policy: cross-origin

# Allow nested JS files
/*/*.js
  Cross-Origin-Resource-Policy: cross-origin

# Force correct MIME types for node_modules JS files
*/node_modules/*.js
  Content-Type: application/javascript
  Cross-Origin-Resource-Policy: cross-origin

# Nested node_modules JS files
*/node_modules/*/*.js
  Content-Type: application/javascript
  Cross-Origin-Resource-Policy: cross-origin

# Deep nested node_modules JS files
*/node_modules/*/*/*.js
  Content-Type: application/javascript
  Cross-Origin-Resource-Policy: cross-origin