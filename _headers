/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Resource-Policy: same-origin

# These pages need SharedArrayBuffer for browser-side image/video processing.
/image-editor/*
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Opener-Policy: same-origin
/video-trimmer/*
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Opener-Policy: same-origin

# Emscripten starts pthread workers from this loader; workers need COEP too.
/vendor/wasm-vips-0.0.19/*
  Cross-Origin-Embedder-Policy: require-corp

# Vite emits content-hashed bundles; vendor directories include package versions.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
