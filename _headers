# Default headers for all pages
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Block access to node_modules
/*/node_modules/*
  X-Robots-Tag: noindex, nofollow
  
# Special headers for image-editor to enable SharedArrayBuffer/WASM
/image-editor/*
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: cross-origin

# Specific headers for image-editor WASM files
/image-editor/lib/*.wasm
  Content-Type: application/wasm
  Cross-Origin-Resource-Policy: cross-origin
  Cross-Origin-Embedder-Policy: require-corp

# Allow WASM files globally
/*.wasm
  Content-Type: application/wasm
  Cross-Origin-Resource-Policy: cross-origin

# Allow nested WASM files
/*/*.wasm
  Content-Type: application/wasm
  Cross-Origin-Resource-Policy: cross-origin

# Allow JS modules globally
/*.js
  Cross-Origin-Resource-Policy: cross-origin

# Allow nested JS files
/*/*.js
  Cross-Origin-Resource-Policy: cross-origin

# Force correct MIME types for all lib directories
/*/lib/*.js
  Content-Type: application/javascript
  Cross-Origin-Resource-Policy: cross-origin

/*/lib/*.wasm
  Content-Type: application/wasm
  Cross-Origin-Resource-Policy: cross-origin